{
    "name": "Sync WhatsApp/IG Leads to Leads Artificia",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "leads-artificia-incoming",
                "responseMode": "lastNode",
                "options": {}
            },
            "id": "e6a12b32-15f5-4c01-add5-e116ad1feef6",
