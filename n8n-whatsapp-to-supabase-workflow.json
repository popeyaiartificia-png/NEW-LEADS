                            "value": "New",
                            "type": "string"
                        },
                        {
                            "id": "6",
                            "name": "notes",
                            "value": "={{ $json.body.message || '' }}",
                            "type": "string"
                        }
                    ]
                },
                "options": {}
            },
            "id": "1b0def93-79cd-4ebb-b4d4-20b328a6f693",
            "name": "Map Lead Data",
            "type": "n8n-nodes-base.set",
            "typeVersion": 3.4,
            "position": [
                420,
                300
            ]
        },
        {
            "parameters": {
                "operation": "insert",
                "tableDefinition": {
                    "__rl": true,
                    "value": "leads",
                    "mode": "list",
                    "cachedResultName": "leads"
                },
                "columns": "name, phone, email, source, status, notes"
            },
            "id": "691764df-e8ed-4b53-aeeb-c0fb127bcfb9",
            "name": "Insert Lead finding into Supabase",
            "type": "n8n-nodes-base.supabase",
            "typeVersion": 1,
            "position": [
                640,
                300
            ],
            "credentials": {
                "supabaseApi": {
                    "id": "YOUR_SUPABASE_CREDENTIAL_ID",
                    "name": "Supabase account"
                }
            }
        }
